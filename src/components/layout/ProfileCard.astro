---
import headshot from "../../assets/headshot.jpg";
import { Icon } from "astro-icon/components";
---

<div class="flex items-center gap-4 my-6">
  <img
    src={headshot.src}
    width={headshot.width}
    height={headshot.height}
    alt="My Avatar"
    class="w-24 lg:w-28 aspect-square rounded"
    loading="eager"
    decoding="async"
  />
  <div class="space-y-1.5 lg:space-y-2.5">
    <h1 class="mb-1 text-3xl lg:text-4xl font-bold">Damilola</h1>
    <a
      class="link hover:text-body text-sm inline-block no-underline"
      href="mailto:damilola@trulydami.me">damilola@trulydami.me</a
    >
    <div class="flex gap-3">
      <a
        class="link hover:text-body"
        href="https://github.com/ddddami"
        title="GitHub"
        target="_blank"
      >
        <Icon size={19} name="tabler:brand-github" />
      </a>

      <a
        class="link hover:text-body"
        href="https://x.com/ddddami_"
        title="Twitter"
        target="_blank"
      >
        <Icon size={19} name="tabler:brand-twitter" />
      </a>

      <a class="link hover:text-body" href="/rss.xml" title="RSS Feed">
        <Icon size={19} name="tabler:rss" />
      </a>

      <a
        href="/feed.json"
        title="JSON Feed"
        class="link hover:text-body text-2xl -mt-0.5"
      >
        <Icon name="tabler:json" />
      </a>
    </div>
  </div>
</div>
